/* Binding directory for the QSHONISRV service program. &O = object library, &N = object name */
/* The delete may fail when the directory is new, so its error is ignored */
!DLTBNDDIR BNDDIR(&O/&N)
CRTBNDDIR BNDDIR(&O/&N) TEXT('Binding Directory for QSHONISRV Service Program')
ADDBNDDIRE BNDDIR(&O/&N) OBJ((&O/QSHONISRV *SRVPGM *IMMED)) POSITION(*LAST)
