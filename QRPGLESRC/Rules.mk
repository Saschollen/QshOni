# Generated for IBM i TOBi (makei). Object library comes from iproj.json.
# ILE RPG programs are built with CRTBNDRPG. TOBi does not pass DFTACTGRP, and CRTBNDRPG then
# defaults to DFTACTGRP(*YES). The original build used DFTACTGRP(*NO), so it is added to each program.
QSHGETPARR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHGETPARR.PGM: QSHGETPARR.RPGLE
QSHIFSCHKR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHIFSCHKR.PGM: QSHIFSCHKR.RPGLE
QSHIFSSCAR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHIFSSCAR.PGM: QSHIFSSCAR.RPGLE
QSHLOGSCAR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHLOGSCAR.PGM: QSHLOGSCAR.RPGLE
QSHQRYSR2R.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHQRYSR2R.PGM: QSHQRYSR2R.RPGLE TMPQRYSRC.FILE
QSHQRYSR3R.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHQRYSR3R.PGM: QSHQRYSR3R.RPGLE TMPQRYSRC.FILE
QSHQRYSRCR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHQRYSRCR.PGM: QSHQRYSRCR.RPGLE
QSHQRYTMPR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHQRYTMPR.PGM: QSHQRYTMPR.RPGLE
QSHSTDOUTR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHSTDOUTR.PGM: QSHSTDOUTR.RPGLE
QSHWRTLOGR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
QSHWRTLOGR.PGM: QSHWRTLOGR.RPGLE
RUNSQLPRMR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
RUNSQLPRMR.PGM: RUNSQLPRMR.RPGLE
RUNSQLSR3R.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
RUNSQLSR3R.PGM: RUNSQLSR3R.RPGLE TMPQRYSRC.FILE
RUNSQLSRCR.PGM: private CRTBNDRPGFLAGS += DFTACTGRP(*NO)
RUNSQLSRCR.PGM: RUNSQLSRCR.RPGLE TMPQRYSRC.FILE

# SQL ILE RPG program (its source already sets ctl-opt dftactgrp(*no) actgrp(*caller))
WRKIFSLISR.PGM: WRKIFSLISR.SQLRPGLE WRKIFSLISD.FILE

# QSHQRYSR2R, QSHQRYSR3R, RUNSQLSRCR and RUNSQLSR3R declare file TMPQRYSRC, which the CL programs create in
# QTEMP at run time. The compiler needs a file with that name and format, so a build-time copy is created.
TMPQRYSRC.FILE:
	system -i "CRTSRCPF FILE(QSHONI/TMPQRYSRC) RCDLEN(240) TEXT('Build time copy of QTEMP/TMPQRYSRC')"

# QSHONISRV service program module. The export source and binding directory rules are in QBNDSRC.
QSHONISRV.MODULE: private DBGVIEW := *SOURCE
QSHONISRV.MODULE: QSHONISRV.RPGLE
